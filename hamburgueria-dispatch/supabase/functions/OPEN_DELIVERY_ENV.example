# Base URLs (obrigatório por plataforma)
OPEN_DELIVERY_99FOOD_BASE_URL=
OPEN_DELIVERY_KEETA_BASE_URL=

# IMPORTANTE MULTI-TENANT:
# client_secret e webhook_secret não devem ser globais em ENV.
# Salve por loja na tabela store_integrations.

# URL para confirmar despacho (opcional)
# Suporta placeholders {orderId} ou :orderId
OPEN_DELIVERY_99FOOD_DISPATCH_CONFIRM_URL=

# Método HTTP da confirmação (opcional, default POST)
OPEN_DELIVERY_99FOOD_DISPATCH_CONFIRM_METHOD=POST
