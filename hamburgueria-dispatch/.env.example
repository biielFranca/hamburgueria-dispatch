# Supabase
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OSRM (roteamento) — opcional, usa servidor público por padrão
VITE_ROUTES_API_URL=https://router.project-osrm.org
VITE_OSRM_PROFILE=driving   # driving | bike | foot

# Tempo de espera para despachar pedido solo (padrão: 10 min)
# Em desenvolvimento, use 1 para facilitar testes
VITE_SOLO_WAIT_MIN=10

# Mapa do Painel Operacional (estilo escuro). Chave gratuita em maptiler.com.
# Sem chave, o app usa tiles do OpenStreetMap com filtro escuro — ok para
# testes, mas a política do OSM não permite uso comercial intenso.
VITE_MAPTILER_KEY=

# NÃO colocar client_secret/service_role/webhook_secret aqui: tudo que começa
# com VITE_ vai dentro do executável. Segredos das plataformas ficam só na
# tabela store_integrations (sem leitura pelo front) e nas Edge Functions.
