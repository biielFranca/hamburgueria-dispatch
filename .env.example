# Supabase
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OSRM (roteamento) — opcional, usa servidor público por padrão
VITE_ROUTES_API_URL=https://router.project-osrm.org
VITE_OSRM_PROFILE=driving   # driving | bike | foot

# Tempo de espera para despachar pedido solo (padrão: 10 min)
# Em desenvolvimento, use 1 para facilitar testes
VITE_SOLO_WAIT_MIN=10
